{
    "name": "Nico Labs AI Chatbot",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "f535820b-22eb-438f-930f-d0f8fe2f3a12/chat",
                "responseMode": "lastNode",
                "options": {}
            },
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2.1,
            "position": [
                0,
                0
            ],
            "id": "chat-webhook-trigger",
            "name": "Chat Webhook"
        },
        {
            "parameters": {
                "options": {
                    "systemMessage": "Eres Nicolás Lanfranco, Consultor de Negocios Persuasivo y CEO de Nico Labs. Licenciado en Administración y Magister en Finanzas. Tu objetivo es ayudar a los visitantes a entender cómo la automatización inteligente puede potenciar su rentabilidad y ROI. Eres profesional, directo, visionario y experto en n8n y PostgreSQL. Servicios: Nicolabs Gym (Gestión deportiva), Nicolabs PRO (Profesionales), Nicolabs CONTY (Contabilidad), Nicolabs COMUNICADOS (Branding IA), Nicolabs REDES (Marketing), Nicolabs WEB (Sitios que convierten). Si el usuario muestra interés real, intenta capturar su nombre y email usando la herramienta capture_lead."
                }
            },
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 1.7,
            "position": [
                250,
                0
            ],
            "id": "ai-agent-node",
            "name": "AI Agent"
        },
        {
            "parameters": {
                "modelName": "gemini-1.5-pro",
                "options": {}
            },
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1,
            "position": [
                200,
                200
            ],
            "id": "gemini-model",
            "name": "Google Gemini"
        },
        {
            "parameters": {
                "operation": "insert",
                "schema": {
                    "__rl": true,
                    "value": "public",
                    "mode": "list"
                },
                "table": {
                    "__rl": true,
                    "value": "chat_memory",
                    "mode": "list"
                },
                "sessionKey": "={{ $json.body.sessionId }}",
                "tableName": "chat_memory"
            },
            "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
            "typeVersion": 1.3,
            "position": [
                350,
                200
            ],
            "id": "postgres-memory",
            "name": "Postgres Chat Memory"
        },
        {
            "parameters": {
                "name": "capture_lead",
                "description": "Usa esta herramienta cuando el usuario proporcione voluntariamente sus datos de contacto (nombre, email, teléfono) para ser contactado por Nico Labs.",
                "workflowId": "={{ $workflow.id }}",
                "responseMode": "lastNode"
            },
            "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
            "typeVersion": 1.2,
            "position": [
                500,
                200
            ],
            "id": "lead-capture-tool",
            "name": "Lead Capture Tool"
        }
    ],
    "connections": {
        "Chat Webhook": {
            "main": [
                [
                    {
                        "node": "AI Agent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Google Gemini": {
            "ai_languageModel": [
                [
                    {
                        "node": "AI Agent",
                        "type": "ai_languageModel",
                        "index": 0
                    }
                ]
            ]
        },
        "Postgres Chat Memory": {
            "ai_memory": [
                [
                    {
                        "node": "AI Agent",
                        "type": "ai_memory",
                        "index": 0
                    }
                ]
            ]
        },
        "Lead Capture Tool": {
            "ai_tool": [
                [
                    {
                        "node": "AI Agent",
                        "type": "ai_tool",
                        "index": 0
                    }
                ]
            ]
        }
    }
}